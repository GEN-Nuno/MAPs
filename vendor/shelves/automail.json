{
  "version": 2,
  "name": "AutoMail Core 設計",
  "activeId": "l1-monthly",
  "diagrams": [
    {
      "id": "l1-monthly",
      "layer": "L1",
      "title": "月次取得の全体フロー",
      "ticketId": "t-impl-follow",
      "participants": [
        {
          "id": "p-op",
          "name": "運用者",
          "kind": "actor"
        },
        {
          "id": "p-sched",
          "name": "Scheduler / CLI",
          "kind": "process"
        },
        {
          "id": "p-core",
          "name": "AutoMail Core",
          "kind": "process"
        },
        {
          "id": "p-drv",
          "name": "Browser Driver",
          "kind": "process"
        },
        {
          "id": "p-site",
          "name": "ベンダーサイト",
          "kind": "system"
        },
        {
          "id": "p-db",
          "name": "SQLite / Storage",
          "kind": "database"
        }
      ],
      "items": [
        {
          "id": "m-l1-1",
          "kind": "message",
          "fromId": "p-op",
          "toId": "p-sched",
          "text": "月次取得を開始 (run コマンド)",
          "arrow": "sync",
          "note": "Scheduler は未実装。現状は CLI / Web からの手動起動"
        },
        {
          "id": "m-l1-2",
          "kind": "message",
          "fromId": "p-sched",
          "toId": "p-core",
          "text": "ジョブ作成 (ベンダー × 対象期間 × 書類種別)",
          "arrow": "sync"
        },
        {
          "id": "b-l1-cred",
          "kind": "block",
          "blockKind": "alt",
          "branches": [
            {
              "id": "br-cred-ok",
              "label": "credential_ref を解決できた (env:// / prompt://)",
              "items": [
                {
                  "id": "m-l1-3",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-drv",
                  "text": "レシピ実行を委譲 (ログイン→請求ページ→期間指定→ダウンロード)",
                  "arrow": "sync"
                },
                {
                  "id": "m-l1-4",
                  "kind": "message",
                  "fromId": "p-drv",
                  "toId": "p-site",
                  "text": "画面操作 (goto / fill / click)。操作間隔は automation.min_interval_seconds を下回らない",
                  "arrow": "sync"
                },
                {
                  "id": "m-l1-5",
                  "kind": "message",
                  "fromId": "p-site",
                  "toId": "p-drv",
                  "text": "ページ・ダウンロードファイル",
                  "arrow": "reply"
                },
                {
                  "id": "b-l1-result",
                  "kind": "block",
                  "blockKind": "alt",
                  "branches": [
                    {
                      "id": "br-ok",
                      "label": "成功 (expect をすべて満たした)",
                      "items": [
                        {
                          "id": "m-l1-6",
                          "kind": "message",
                          "fromId": "p-core",
                          "toId": "p-db",
                          "text": "_pending に一時保存 → 検証・抽出・重複判定 → 正式保存",
                          "arrow": "sync",
                          "linkTargetId": "l2-save"
                        },
                        {
                          "id": "m-l1-7",
                          "kind": "message",
                          "fromId": "p-core",
                          "toId": "p-db",
                          "text": "証跡ログ・ファイルハッシュを記録",
                          "arrow": "sync"
                        },
                        {
                          "id": "m-l1-8",
                          "kind": "message",
                          "fromId": "p-core",
                          "toId": "p-op",
                          "text": "サマリ通知 (成功 / success_no_data)",
                          "arrow": "reply"
                        }
                      ]
                    },
                    {
                      "id": "br-human",
                      "label": "MFA・CAPTCHA を検出 (人間介入)",
                      "items": [
                        {
                          "id": "m-l1-9",
                          "kind": "message",
                          "fromId": "p-core",
                          "toId": "p-op",
                          "text": "waiting_for_human を通知 (ブラウザは開いたまま保持)",
                          "arrow": "async",
                          "linkTargetId": "l2-mfa"
                        },
                        {
                          "id": "m-l1-10",
                          "kind": "message",
                          "fromId": "p-op",
                          "toId": "p-site",
                          "text": "MFA コード入力 (CAPTCHA の自動突破はしない)",
                          "arrow": "sync"
                        },
                        {
                          "id": "m-l1-11",
                          "kind": "message",
                          "fromId": "p-core",
                          "toId": "p-drv",
                          "text": "ログイン完了を確認して再開 (待機は既定30分まで)",
                          "arrow": "sync"
                        }
                      ]
                    },
                    {
                      "id": "br-fail",
                      "label": "失敗 (想定外ページ・セレクタ不一致 等)",
                      "items": [
                        {
                          "id": "m-l1-12",
                          "kind": "message",
                          "fromId": "p-core",
                          "toId": "p-db",
                          "text": "スクリーンショット・HTML 保存、失敗分類を記録",
                          "arrow": "sync",
                          "linkTargetId": "l2-failure"
                        },
                        {
                          "id": "m-l1-13",
                          "kind": "message",
                          "fromId": "p-core",
                          "toId": "p-op",
                          "text": "失敗理由 (分類) と次の対応を通知。推測で先へは進まない",
                          "arrow": "reply"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "br-cred-ng",
              "label": "解決できない (未登録・vault:// 未実装)",
              "items": [
                {
                  "id": "m-l1-14",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-op",
                  "text": "credential_not_found として実行前に停止 (ログイン試行はしない)",
                  "arrow": "lost",
                  "note": "auth_failed (ログイン試行後の失敗) とは区別する。設計書 §19.1"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "l2-failure",
      "layer": "L2",
      "title": "失敗分類と修復 (§13 / §18.2)",
      "parentId": "l1-monthly",
      "ticketId": "t-impl-follow",
      "participants": [
        {
          "id": "p-core",
          "name": "AutoMail Core",
          "kind": "process"
        },
        {
          "id": "p-ai",
          "name": "AI Adapter",
          "kind": "system"
        },
        {
          "id": "p-op",
          "name": "運用者",
          "kind": "actor"
        },
        {
          "id": "p-db",
          "name": "SQLite / Storage",
          "kind": "database"
        }
      ],
      "items": [
        {
          "id": "m-f-1",
          "kind": "message",
          "fromId": "p-core",
          "toId": "p-db",
          "text": "失敗分類を記録 (18種: 16 + captcha_required + credential_not_found)",
          "arrow": "sync"
        },
        {
          "id": "b-f-alt",
          "kind": "block",
          "blockKind": "alt",
          "branches": [
            {
              "id": "br-f-nodata",
              "label": "document_not_found (書類0件)",
              "items": [
                {
                  "id": "m-f-2",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-db",
                  "text": "success_no_data として記録",
                  "arrow": "sync",
                  "note": "成功扱いは「一覧要素の取得＋期間指定成功＋0件表示の確認」の3条件を満たす場合のみ。一覧自体が見つからなければ ui_changed。§13.3"
                },
                {
                  "id": "m-f-3",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-op",
                  "text": "同一ベンダーで3回連続 no_data なら review_required (取得漏れ検知)",
                  "arrow": "async"
                }
              ]
            },
            {
              "id": "br-f-ui",
              "label": "ui_changed (画面構造の変更)",
              "items": [
                {
                  "id": "m-f-4",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-ai",
                  "text": "修復候補を依頼 (渡すのは sanitizer のマスク済み断片のみ。PDF・HTML の全文は渡さない)",
                  "arrow": "sync"
                },
                {
                  "id": "m-f-5",
                  "kind": "message",
                  "fromId": "p-ai",
                  "toId": "p-core",
                  "text": "セレクタ候補・レシピ修正案 (repair_proposal)",
                  "arrow": "reply"
                },
                {
                  "id": "m-f-6",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-op",
                  "text": "Dry Run (download/save/DB書込なし) の結果を添えて人間レビューへ",
                  "arrow": "sync"
                },
                {
                  "id": "m-f-7",
                  "kind": "message",
                  "fromId": "p-op",
                  "toId": "p-core",
                  "text": "承認 → レシピ version+1、旧版は history/ にバックアップ",
                  "arrow": "reply"
                }
              ]
            },
            {
              "id": "br-f-stop",
              "label": "captcha_required / unexpected_page (即停止系)",
              "items": [
                {
                  "id": "m-f-8",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-op",
                  "text": "即停止して人間対応へ。回避・突破・強行操作はしない (§19.4)",
                  "arrow": "lost"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "l2-mfa",
      "layer": "L2",
      "title": "MFA 待機と再開 (§14.4)",
      "parentId": "l1-monthly",
      "ticketId": "t-storage-state",
      "participants": [
        {
          "id": "p-op",
          "name": "運用者",
          "kind": "actor"
        },
        {
          "id": "p-core",
          "name": "AutoMail Core",
          "kind": "process"
        },
        {
          "id": "p-drv",
          "name": "Browser Driver",
          "kind": "process"
        },
        {
          "id": "p-site",
          "name": "ベンダーサイト",
          "kind": "system"
        }
      ],
      "items": [
        {
          "id": "m-m-1",
          "kind": "message",
          "fromId": "p-drv",
          "toId": "p-core",
          "text": "MFA 画面を検出 (detect)",
          "arrow": "reply"
        },
        {
          "id": "m-m-2",
          "kind": "message",
          "fromId": "p-core",
          "toId": "p-op",
          "text": "waiting_for_human を通知 (Web UI のバナー)",
          "arrow": "async",
          "note": "再開に必要なのは生きたブラウザセッション。DB に保存できる状態ではないため、ブラウザは閉じずに同一プロセス内で保持する (headless=false 前提)"
        },
        {
          "id": "b-m-alt",
          "kind": "block",
          "blockKind": "alt",
          "branches": [
            {
              "id": "br-m-ok",
              "label": "30分以内に人間が入力した",
              "items": [
                {
                  "id": "m-m-3",
                  "kind": "message",
                  "fromId": "p-op",
                  "toId": "p-site",
                  "text": "MFA コードを入力",
                  "arrow": "sync"
                },
                {
                  "id": "m-m-4",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-drv",
                  "text": "ログイン完了を確認してジョブ再開",
                  "arrow": "sync"
                },
                {
                  "id": "m-m-5",
                  "kind": "message",
                  "fromId": "p-drv",
                  "toId": "p-core",
                  "text": "storage_state を暗号化して保存 (後続ジョブの再ログイン省略。ログには出さない)",
                  "arrow": "reply"
                }
              ]
            },
            {
              "id": "br-m-timeout",
              "label": "タイムアウト (既定30分)",
              "items": [
                {
                  "id": "m-m-6",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-op",
                  "text": "mfa_required のまま failed。再実行はジョブの最初からやり直す (ステップ途中からの復元は MVP スコープ外)",
                  "arrow": "lost"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "l2-save",
      "layer": "L2",
      "title": "保存ステージング (§15.4)",
      "parentId": "l1-monthly",
      "ticketId": "t-impl-follow",
      "participants": [
        {
          "id": "p-core",
          "name": "AutoMail Core",
          "kind": "process"
        },
        {
          "id": "p-db",
          "name": "SQLite / Storage",
          "kind": "database"
        },
        {
          "id": "p-op",
          "name": "運用者",
          "kind": "actor"
        }
      ],
      "items": [
        {
          "id": "m-s-1",
          "kind": "message",
          "fromId": "p-core",
          "toId": "p-db",
          "text": "storage/_pending/{job_id}/ に一時保存",
          "arrow": "sync",
          "note": "正式なファイル名は invoice_no と amount を要求するため、メタデータ確定前は正式保存できない"
        },
        {
          "id": "m-s-2",
          "kind": "message",
          "fromId": "p-core",
          "toId": "p-db",
          "text": "ファイル検証 (存在・サイズ・PDF可読) → メタデータ抽出 → 重複判定",
          "arrow": "sync",
          "note": "重複判定の MVP はハッシュ・請求番号・日付+金額の3手段のみ。日付+金額の単独一致は possible_duplicate 止まり (同額の月額課金で誤検知するため)。§11"
        },
        {
          "id": "b-s-alt",
          "kind": "block",
          "blockKind": "alt",
          "branches": [
            {
              "id": "br-s-ok",
              "label": "検証・抽出・重複判定がすべて成功",
              "items": [
                {
                  "id": "m-s-3",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-db",
                  "text": "正式パスへ命名して移動 ({vendor}/{年}/{月}/ + 命名規則)。ハッシュを DB に記録",
                  "arrow": "sync"
                }
              ]
            },
            {
              "id": "br-s-meta",
              "label": "metadata_missing (必須項目が抽出できない)",
              "items": [
                {
                  "id": "m-s-4",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-op",
                  "text": "review_required を通知。ファイルは _pending に保持",
                  "arrow": "async"
                },
                {
                  "id": "m-s-5",
                  "kind": "message",
                  "fromId": "p-op",
                  "toId": "p-core",
                  "text": "人間が値を補完・確定",
                  "arrow": "sync"
                },
                {
                  "id": "m-s-6",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-db",
                  "text": "確定値で正式パスへ移動",
                  "arrow": "sync"
                }
              ]
            },
            {
              "id": "br-s-dup",
              "label": "possible_duplicate / version_changed",
              "items": [
                {
                  "id": "m-s-7",
                  "kind": "message",
                  "fromId": "p-core",
                  "toId": "p-op",
                  "text": "人間レビューへ。自動上書き・自動確定はしない",
                  "arrow": "async",
                  "note": "再発行等で金額が変わっても既存ファイルはリネームしない。正は DB のメタデータ (電帳法の検索要件も DB で担保。§15.5)"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "l1-followup",
      "layer": "L1",
      "title": "設計書の実装追随運用 (§23.3)",
      "ticketId": "t-audit-reflect",
      "participants": [
        {
          "id": "p-dev",
          "name": "開発者",
          "kind": "actor"
        },
        {
          "id": "p-doc",
          "name": "AUTOMAIL_CORE_DESIGN.md",
          "kind": "system"
        },
        {
          "id": "p-shelf",
          "name": "SeqShelf 本棚 (automail.json)",
          "kind": "system"
        },
        {
          "id": "p-code",
          "name": "automail/ 実装",
          "kind": "process"
        }
      ],
      "items": [
        {
          "id": "m-fu-1",
          "kind": "message",
          "fromId": "p-dev",
          "toId": "p-doc",
          "text": "実装前に設計節を追記・更新する (なぜ今のままでは駄目かを書く)",
          "arrow": "sync"
        },
        {
          "id": "m-fu-2",
          "kind": "message",
          "fromId": "p-dev",
          "toId": "p-shelf",
          "text": "図とチケットを更新し validate / review で指摘 0 を確認",
          "arrow": "sync"
        },
        {
          "id": "m-fu-2r",
          "kind": "message",
          "fromId": "p-shelf",
          "toId": "p-dev",
          "text": "validate / review の結果 (指摘一覧。0 になるまで設計を直す)",
          "arrow": "reply"
        },
        {
          "id": "m-fu-3",
          "kind": "message",
          "fromId": "p-dev",
          "toId": "p-code",
          "text": "設計に沿って実装 (違う判断をしたらメモを残す)",
          "arrow": "sync"
        },
        {
          "id": "m-fu-3r",
          "kind": "message",
          "fromId": "p-code",
          "toId": "p-dev",
          "text": "テスト結果 (失敗があれば実装かレシピを直してから次へ)",
          "arrow": "reply"
        },
        {
          "id": "m-fu-4",
          "kind": "message",
          "fromId": "p-dev",
          "toId": "p-doc",
          "text": "as-built を §23.2 へ反映 (モジュールの新設・改名は §4 責務表と同じコミットで)",
          "arrow": "sync",
          "note": "2026-08-19 の監査で「ドラフトのまま実装が先行し乖離」を検出した再発防止。設計にあって実装にないもの・実装にあって設計にないものを放置しない"
        },
        {
          "id": "b-fu-alt",
          "kind": "block",
          "blockKind": "opt",
          "branches": [
            {
              "id": "br-fu-gap",
              "label": "乖離を見つけた場合",
              "items": [
                {
                  "id": "m-fu-5",
                  "kind": "message",
                  "fromId": "p-dev",
                  "toId": "p-shelf",
                  "text": "監査チケットを起票し、指摘と反映先を記録してから直す (AM-1 の例に倣う)",
                  "arrow": "sync"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "l3-save-fn",
      "layer": "L3",
      "title": "保存ステージングの関数フロー (§15.4 実装設計)",
      "parentId": "l2-save",
      "ticketId": "t-impl-follow",
      "participants": [
        {
          "id": "p-core",
          "name": "AutoMailCore._finalize",
          "kind": "function"
        },
        {
          "id": "p-sm",
          "name": "StorageManager",
          "kind": "class"
        },
        {
          "id": "p-dd",
          "name": "DuplicateDetector",
          "kind": "class"
        },
        {
          "id": "p-repo",
          "name": "Repository (SQLite)",
          "kind": "class"
        }
      ],
      "items": [
        {
          "id": "m-s3-1",
          "kind": "message",
          "fromId": "p-core",
          "toId": "p-sm",
          "text": "save_pending(job_id, file) — storage/_pending/{job_id}/ へ一時保存 [実装済み]",
          "arrow": "sync",
          "note": "as-built: 実装前は metadata_missing 時にファイルが work_dir ごと削除され消失していた。AutoMailCore._finalize を work_dir 削除より前に移して _pending 退避を実装（test_automail_newspec.py で検証）"
        },
        {
          "id": "m-s3-2",
          "kind": "message",
          "fromId": "p-core",
          "toId": "p-core",
          "text": "ファイル検証 (存在・サイズ下限・PDF 可読) とメタデータ抽出 (現状は簡易実装)",
          "arrow": "sync"
        },
        {
          "id": "m-s3-3",
          "kind": "message",
          "fromId": "p-core",
          "toId": "p-dd",
          "text": "check(hash, invoice_no, date+amount) — MVP は3手段のみ",
          "arrow": "sync"
        },
        {
          "id": "m-s3-4",
          "kind": "message",
          "fromId": "p-dd",
          "toId": "p-core",
          "text": "new / exact_duplicate / possible_duplicate (date+amount 単独一致は possible 止まり)",
          "arrow": "reply"
        },
        {
          "id": "b-s3-alt",
          "kind": "block",
          "blockKind": "alt",
          "branches": [
            {
              "id": "br-s3-ok",
              "label": "検証・抽出・重複判定がすべて成功",
              "items": [
                {
                  "id": "m-s3-5",
                  "kind": "message",
